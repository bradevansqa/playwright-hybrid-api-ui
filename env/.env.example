# Application URLs
APP_URL=https://your-app-url.com
API_URL=https://your-api-url.com

# Authentication Credentials (admin — the default role for tests)
APP_EMAIL=your-email@example.com
APP_PASSWORD=your-secure-password

# Customer (non-admin) credentials — required by role-based access tests
CUSTOMER_EMAIL=your-customer-email@example.com
CUSTOMER_PASSWORD=your-customer-password

# Second customer — required by cross-customer isolation tests (API only)
CUSTOMER2_EMAIL=your-second-customer-email@example.com
CUSTOMER2_PASSWORD=your-second-customer-password

# Optional: Additional service URLs
UTILITY_URL=https://your-utility-service.com
